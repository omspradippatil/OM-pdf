/*
  X-Frame-Options: SAMEORIGIN
  X-XSS-Protection: 1; mode=block
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval' blob: https://www.googletagmanager.com https://apis.google.com https://*.firebaseapp.com https://www.gstatic.com https://cdn.jsdelivr.net https://static.cloudflareinsights.com; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://*.googleusercontent.com; connect-src 'self' data: blob: https://*.workers.dev https://*.googleapis.com https://*.firebaseio.com https://*.firebase.google.com https://cdn.jsdelivr.net https://cloudflareinsights.com https://huggingface.co https://*.huggingface.co https://*.hf.co https://*.mlc.ai https://www.google-analytics.com https://*.githubusercontent.com https://raw.githubusercontent.com https://api.openai.com https://api.groq.com https://openrouter.ai; frame-src 'self' https://*.firebaseapp.com https://*.google.com;

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/sitemap.xml
  Content-Type: application/xml
  Cache-Control: public, max-age=0, must-revalidate

/feed.xml
  Content-Type: application/rss+xml; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate

/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate

