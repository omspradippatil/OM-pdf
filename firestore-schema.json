{
  "_info": {
    "project": "OM PDF",
    "description": "Firestore DB schema — import this as reference when configuring Firebase Console",
    "collections": ["user_files", "users", "user_actions"],
    "rules_file": "firestore.rules"
  },

  "collections": {
    "user_files": {
      "_description": "Stores metadata for every PDF saved to cloud by a logged-in user.",
      "_path": "user_files/{docId}",
      "_indexes": [
        { "fields": ["uid", "createdAt"], "order": "DESCENDING", "purpose": "My Files dashboard list" }
      ],
      "schema": {
        "uid": {
          "type": "string",
          "required": true,
          "description": "Firebase Auth UID of the file owner"
        },
        "name": {
          "type": "string",
          "required": true,
          "description": "Output filename e.g. merged_2026-05-02_21-15-00.pdf"
        },
        "size": {
          "type": "number",
          "required": true,
          "description": "File size in bytes"
        },
        "pages": {
          "type": "number",
          "required": false,
          "description": "Total page count of the merged PDF (optional)"
        },
        "tool": {
          "type": "string",
          "required": false,
          "enum": ["merge", "split", "rotate", "page_numbers"],
          "description": "Which tool was used to produce this file"
        },
        "url": {
          "type": "string",
          "required": true,
          "description": "Firebase Storage download URL"
        },
        "storagePath": {
          "type": "string",
          "required": true,
          "description": "Full storage path e.g. users/{uid}/merged_2026-05-02_21-15-00.pdf — used for deletion"
        },
        "createdAt": {
          "type": "timestamp",
          "required": true,
          "description": "Server timestamp — use serverTimestamp() when writing"
        }
      },
      "sample_document": {
        "uid": "abc123firebaseUid",
        "name": "merged_2026-05-02_21-15-00.pdf",
        "size": 2457600,
        "pages": 12,
        "tool": "merge",
        "url": "https://firebasestorage.googleapis.com/v0/b/om-pdf.appspot.com/...",
        "storagePath": "users/abc123firebaseUid/merged_2026-05-02_21-15-00.pdf",
        "createdAt": "2026-05-02T15:45:00Z"
      }
    },
    "users": {
      "_description": "User profile document created at sign-in.",
      "_path": "users/{uid}",
      "schema": {
        "uid": {
          "type": "string",
          "required": true,
          "description": "Firebase Auth UID"
        },
        "email": {
          "type": "string",
          "required": false,
          "description": "User email address"
        },
        "displayName": {
          "type": "string",
          "required": false,
          "description": "User display name"
        },
        "photoURL": {
          "type": "string",
          "required": false,
          "description": "Profile photo URL"
        },
        "provider": {
          "type": "string",
          "required": false,
          "description": "Auth provider id, e.g. google.com"
        },
        "createdAt": {
          "type": "timestamp",
          "required": true,
          "description": "Server timestamp at first sign-in"
        },
        "lastLoginAt": {
          "type": "timestamp",
          "required": true,
          "description": "Server timestamp of latest sign-in"
        }
      },
      "sample_document": {
        "uid": "abc123firebaseUid",
        "email": "user@example.com",
        "displayName": "Alex Doe",
        "photoURL": "https://lh3.googleusercontent.com/...",
        "provider": "google.com",
        "createdAt": "2026-05-02T15:45:00Z",
        "lastLoginAt": "2026-05-08T10:12:00Z"
      }
    },
    "user_actions": {
      "_description": "Append-only audit log for user actions.",
      "_path": "user_actions/{docId}",
      "_indexes": [
        { "fields": ["uid", "createdAt"], "order": "DESCENDING", "purpose": "User activity timeline" }
      ],
      "schema": {
        "uid": {
          "type": "string",
          "required": true,
          "description": "Firebase Auth UID"
        },
        "email": {
          "type": "string",
          "required": false,
          "description": "User email"
        },
        "displayName": {
          "type": "string",
          "required": false,
          "description": "User display name"
        },
        "action": {
          "type": "string",
          "required": true,
          "description": "Action identifier, e.g. merge, split_range, drive_upload"
        },
        "tool": {
          "type": "string",
          "required": false,
          "description": "Tool name, if applicable"
        },
        "status": {
          "type": "string",
          "required": true,
          "description": "success or error"
        },
        "meta": {
          "type": "map",
          "required": false,
          "description": "Additional metadata about the action"
        },
        "clientTime": {
          "type": "string",
          "required": false,
          "description": "Client-side timestamp (ISO string)"
        },
        "createdAt": {
          "type": "timestamp",
          "required": true,
          "description": "Server timestamp for the action"
        }
      },
      "sample_document": {
        "uid": "abc123firebaseUid",
        "email": "user@example.com",
        "displayName": "Alex Doe",
        "action": "merge",
        "tool": "merge",
        "status": "success",
        "meta": { "files": 3, "pages": 12, "outputName": "merged_2026-05-08_10-10-00.pdf" },
        "clientTime": "2026-05-08T10:10:00Z",
        "createdAt": "2026-05-08T10:10:00Z"
      }
    }
  },

  "security_rules": {
    "note": "Paste these rules in Firebase Console → Firestore → Rules",
    "rules": "rules_version = '2'; service cloud.firestore { match /databases/{database}/documents { match /user_files/{docId} { allow read, delete: if request.auth != null && request.auth.uid == resource.data.uid; allow create: if request.auth != null && request.auth.uid == request.resource.data.uid; allow update: if false; } match /users/{uid} { allow read, write: if request.auth != null && request.auth.uid == uid; } match /user_actions/{docId} { allow read: if request.auth != null && request.auth.uid == resource.data.uid; allow create: if request.auth != null && request.auth.uid == request.resource.data.uid; allow update, delete: if false; } } }"
  },

  "storage_rules": {
    "note": "Paste these rules in Firebase Console → Storage → Rules",
    "rules": "rules_version = '2'; service firebase.storage { match /b/{bucket}/o { match /users/{uid}/{allPaths=**} { allow read, write, delete: if request.auth != null && request.auth.uid == uid; } } }"
  }
}
