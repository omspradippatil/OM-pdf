rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function nullableString(value, maxLength) {
      return value == null || (value is string && value.size() <= maxLength);
    }

    function validUserProfileBase(uid) {
      return request.resource.data.keys().hasOnly([
               'uid',
               'email',
               'displayName',
               'photoURL',
               'provider',
               'createdAt',
               'lastLoginAt'
             ])
             && request.resource.data.uid == uid
             && nullableString(request.resource.data.email, 320)
             && nullableString(request.resource.data.displayName, 120)
             && nullableString(request.resource.data.photoURL, 2048)
             && request.resource.data.provider is string
             && request.resource.data.provider.size() <= 80
             && request.resource.data.lastLoginAt == request.time;
    }

    function validNewUserProfile(uid) {
      return validUserProfileBase(uid)
             && request.resource.data.keys().hasAll([
                  'uid',
                  'provider',
                  'createdAt',
                  'lastLoginAt'
                ])
             && request.resource.data.createdAt == request.time;
    }

    function validExistingUserProfile(uid) {
      return validUserProfileBase(uid)
             && request.resource.data.uid == resource.data.uid
             && (
               !('createdAt' in resource.data)
               || request.resource.data.createdAt == resource.data.createdAt
             )
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                  'email',
                  'displayName',
                  'photoURL',
                  'provider',
                  'lastLoginAt'
                ]);
    }

    function validOptionalCounter(field) {
      return !(field in request.resource.data)
             || (
               request.resource.data[field] is int
               && request.resource.data[field] >= 0
               && request.resource.data[field] <= 1000000
             );
    }

    function validStats() {
      return request.resource.data.keys().hasOnly([
               'localJobs',
               'driveUploads',
               'cloudUploads'
             ])
             && validOptionalCounter('localJobs')
             && validOptionalCounter('driveUploads')
             && validOptionalCounter('cloudUploads');
    }

    // 1. Logs & Activity Tracking
    match /logs/{docId} {
      // Require authentication to create logs, but keep them read-only (Admin only)
      // Enforce small document size and valid timestamp
      allow create: if request.auth != null 
                    && request.resource.data.size() < 10 
                    && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false; 
    }

    // 2. User Profiles & Sub-collections
    match /users/{uid} {
      allow read: if signedInAs(uid);
      allow create: if signedInAs(uid)
                    && validNewUserProfile(uid);
      allow update: if signedInAs(uid)
                    && validExistingUserProfile(uid);
      allow delete: if false;

      match /private/stats {
        allow read: if signedInAs(uid);
        allow create, update: if signedInAs(uid) && validStats();
        allow delete: if false;
      }
    }

    // 3. User Files (Storage Metadata)
    match /user_files/{docId} {
      allow read, delete: if request.auth != null && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null 
                    && request.auth.uid == request.resource.data.uid
                    && request.resource.data.name.size() < 255;
      allow update: if false;
    }

    // 4. Detailed Actions
    match /user_actions/{docId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null 
                    && request.auth.uid == request.resource.data.uid
                    && request.resource.data.size() < 15;
      allow update, delete: if false;
    }

    // 5. Feedback Collection
    match /feedback/{docId} {
      // Allow anyone to submit feedback, but with strict validation
      allow create: if request.resource.data.message is string 
                    && request.resource.data.message.size() > 0 
                    && request.resource.data.message.size() < 3000
                    && request.resource.data.type in ['suggestion', 'bug', 'other']
                    && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    // Default deny
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
