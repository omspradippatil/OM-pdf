rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Logs & Activity Tracking
    match /logs/{docId} {
      // Require authentication to create logs, but keep them read-only (Admin only)
      allow create: if request.auth != null; 
      allow read, update, delete: if false; 
    }

    // 2. User Profiles & Sub-collections
    match /users/{uid} {
      // Allow user to read/write their main profile document
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // ALLOW private stats syncing
      match /private/stats {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // 3. User Files (Storage Metadata)
    match /user_files/{docId} {
      allow read, delete: if request.auth != null && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow update: if false;
    }

    // 4. Detailed Actions
    match /user_actions/{docId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow update, delete: if false;
    }

    // Default deny
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
